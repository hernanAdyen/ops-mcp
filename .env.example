# Copy to .env and fill in. .env is git-ignored: keep real values (passwords, keys, internal URLs) only there.
# Each machine has its own .env. Nothing in it needs to move between laptops.

# --- Docker images and package index -------------------------------------------------------------
# Leave blank to use the public ones (python:3.13-slim, pgvector/pgvector:pg18, PyPI).
# On a work laptop where Docker Hub and PyPI are blocked, set the internal registry and mirror.
PYTHON_IMAGE=
POSTGRES_IMAGE=
UV_DEFAULT_INDEX=

# --- Postgres (local Docker) ----------------------------------------------------------------------
# Admin (superuser) password, used only for setup and maintenance. Required.
POSTGRES_ADMIN_PASSWORD=
# The app's own login and database, created on the first start. The password is required.
APP_DB_USER=imcp
APP_DB_PASSWORD=
APP_DB_NAME=imcp

# --- Links (point at COPIES while testing; originals only when going live) ---------------------------
# The master question bank sheet. Required: /create-scope copies it.
QUESTION_BANK_URL=
# The feedback form shown at the end of each command. {generation_id} is filled in if present.
FEEDBACK_FORM_URL=
# Not used yet (for /propose-solution and proposal ingestion)
PROPOSAL_MASTER_URL=
PROPOSALS_DRIVE_FOLDER_URL=

# --- Model: any OpenAI-compatible chat completions API ------------------------------------------------
# Work laptop: the internal model's URL, name and key. Personal machine: for example
#   MODEL_BASE_URL=https://api.openai.com/v1   MODEL_NAME=gpt-4.1-mini   MODEL_API_KEY=sk-...
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Not used yet
EMBEDDING_MODEL=

# --- Feature flags -----------------------------------------------------------------------------------
# curated | graph | both (not used yet)
FLAG_RECOMMENDER=curated
# Remove email addresses and phone numbers from what we write
FLAG_SANITIZE=true
# Send new questions (generic wording only, and only with the IM's consent) to our review queue
FLAG_CANDIDATE_QUEUE=false

# --- Not used yet --------------------------------------------------------------------------------------
# Google service account key (path to the JSON file, kept outside the repo), for server-side Sheets access
GOOGLE_APPLICATION_CREDENTIALS=
